FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /agentguard-api ./apps/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /agentguard-api /agentguard-api
ENV ADDR=:8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/agentguard-api"]
